# Configuración local de la API. Copia este archivo a .env (que no se versiona)
# y rellena el secreto:
#     Copy-Item .env.example .env
# Arranque leyendo el .env:
#     uv run --env-file .env uvicorn app.main:app --reload --port 8000

# Secreto con el que se firman los tokens JWT. Obligatorio para arrancar la
# API, al menos 32 caracteres. Genera uno con:
#     uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cada entorno tiene el suyo. Si se filtra, se cambia: todos los tokens
# firmados con el anterior dejan de valer.
NEXOVA_API_JWT_SECRET_KEY=

# Minutos de validez de un token (de 1 a 1440).
NEXOVA_API_ACCESS_TOKEN_EXPIRE_MINUTES=30
