# Configuración local de la API. Copia este archivo a .env (que no se versiona)
# y rellena el secreto:
#     Copy-Item .env.example .env
# Arranque leyendo el .env:
#     uv run --env-file .env uvicorn app.main:app --reload --port 8000

# Secreto con el que se firman los tokens JWT. Obligatorio para arrancar la
# API, al menos 32 caracteres. Genera uno con:
#     uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cada entorno tiene el suyo. Si se filtra, se cambia: todos los tokens
# firmados con el anterior dejan de valer.
NEXOVA_API_JWT_SECRET_KEY=

# Minutos de validez de un token (de 1 a 1440).
NEXOVA_API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Restablecimiento de contraseña (AUTH-03) ---

# API key de Resend (https://resend.com → API Keys), para enviar el email con
# el enlace de restablecimiento. Secreta: solo aquí, nunca en el código.
# Si se deja vacía, la API arranca igual y escribe el enlace en su log en vez
# de enviarlo (útil para desarrollar sin cuenta).
NEXOVA_API_RESEND_API_KEY=

# Remitente. El de pruebas de Resend no necesita dominio propio, pero solo
# entrega al email con el que se creó la cuenta de Resend.
NEXOVA_API_EMAIL_FROM=Nexova Solutions <onboarding@resend.dev>

# URL del backoffice: el email enlaza a <esta URL>/reset-password?token=...
NEXOVA_API_FRONTEND_URL=http://localhost:3000

# Minutos de validez del enlace de restablecimiento (de 15 a 60).
NEXOVA_API_RESET_TOKEN_EXPIRE_MINUTES=30

# Solicitudes de restablecimiento por email y hora. Las de más reciben el
# mismo 200, pero no envían email.
NEXOVA_API_RESET_REQUESTS_PER_HOUR=3
